# Startup defaults only. Ctrl+X saved connection config overrides these values.
# User-level connection config: ~/.alyce/config.json
# Project-level connection config: ./.alyce/config.json
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Optional: extra directories outside workspace, separated by system path delimiter
AGENT_ADDITIONAL_DIRECTORIES=
AGENT_SESSION_MEMORY_FILE=SESSION_MEMORY.md
AGENT_SESSION_MEMORY_ENABLED=true
AGENT_SESSION_MEMORY_INIT_TOKENS=10000
AGENT_SESSION_MEMORY_UPDATE_TOKENS=5000
AGENT_SESSION_MEMORY_TOOL_CALLS=3
AGENT_SESSION_MEMORY_TIMEOUT_MS=180000
AGENT_SESSION_MEMORY_MAX_FAILURES=3
AGENT_SESSION_MEMORY_STALE_MS=60000
AGENT_SESSION_MEMORY_WINDOW_MESSAGES=80
AGENT_SESSION_MEMORY_MAX_CHARS_PER_MESSAGE=1500

# Optional automatic compaction tuning
AGENT_AUTO_COMPACT_TIMEOUT_MS=180000
AGENT_AUTO_COMPACT_MAX_FAILURES=3

# Optional web search provider: auto, brave, exa, or duckduckgo
# auto tries Brave Search first when a key is set, then Exa MCP, then DuckDuckGo HTML.
ALYCE_WEB_SEARCH_PROVIDER=auto
# Optional Brave Search API key
ALYCE_BRAVE_SEARCH_API_KEY=
# Optional in-memory provider-result cache TTL in milliseconds. Set 0 to disable.
ALYCE_WEB_SEARCH_CACHE_TTL_MS=600000
# Optional overrides for direct DuckDuckGo fallback requests
ALYCE_WEB_SEARCH_USER_AGENT=
ALYCE_WEB_SEARCH_HONEST_USER_AGENT=
ALYCE_WEB_SEARCH_ACCEPT_LANGUAGE=en-US,en;q=0.9

# Optional WebFetch tuning
ALYCE_WEB_FETCH_MAX_BYTES=5242880
ALYCE_WEB_FETCH_CACHE_TTL_MS=600000
ALYCE_WEB_FETCH_CACHE_MAX_BYTES=33554432
ALYCE_WEB_FETCH_USER_AGENT=
ALYCE_WEB_FETCH_HONEST_USER_AGENT=
ALYCE_WEB_FETCH_ACCEPT_LANGUAGE=en-US,en;q=0.9
